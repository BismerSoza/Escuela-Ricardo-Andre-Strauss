@model List<UsuarioAdminViewModel>
@{
    ViewData["Title"] = "Usuarios";
    var filtro = ViewBag.FiltroRol as string;
    var idPropio = ViewBag.IdPropio as string;
    var claveTemporal = TempData["ClaveTemporal"] as string;
    var claveUsuario = TempData["ClaveUsuario"] as string;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-people me-2"></i>Gestión de Usuarios</h3>
    <a asp-controller="Admin" asp-action="RegistrarUsuario" class="btn btn-principal"><i class="bi bi-plus-lg"></i> Nuevo usuario</a>
</div>

@if (!string.IsNullOrEmpty(claveTemporal))
{
    <div class="alert alert-warning mt-3">
        <i class="bi bi-key me-1"></i>
        Contraseña temporal de <strong>@claveUsuario</strong>: <code class="fs-5 user-select-all">@claveTemporal</code><br />
        <small>Entréguesela al usuario ahora. Por seguridad no se vuelve a mostrar; él puede cambiarla en «Mi perfil y contraseña».</small>
    </div>
}

<div class="btn-group my-3">
    <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-sm @(filtro == null ? "btn-principal" : "btn-outline-secondary")">Todos</a>
    <a asp-controller="Admin" asp-action="Usuarios" asp-route-rol="Director" class="btn btn-sm @(filtro == "Director" ? "btn-principal" : "btn-outline-secondary")">Directores</a>
    <a asp-controller="Admin" asp-action="Usuarios" asp-route-rol="Docente" class="btn btn-sm @(filtro == "Docente" ? "btn-principal" : "btn-outline-secondary")">Docentes</a>
    <a asp-controller="Admin" asp-action="Usuarios" asp-route-rol="Estudiante" class="btn btn-sm @(filtro == "Estudiante" ? "btn-principal" : "btn-outline-secondary")">Estudiantes</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Sección</th><th>Estado</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="6" class="text-muted">No hay usuarios registrados.</td></tr>
                    }
                    else
                    {
                        foreach (var u in Model)
                        {
                            var esPropio = u.ConsecutivoUsuario.ToString() == idPropio;
                            <tr>
                                <td>@u.Nombre @if (esPropio) { <span class="text-muted small">(usted)</span> }</td>
                                <td>@u.CorreoElectronico</td>
                                <td><span class="badge bg-secondary">@u.Rol</span></td>
                                <td>@(u.Seccion ?? "-")</td>
                                <td>
                                    @if (u.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else if (u.Pendiente)
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente de aprobación</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                    @if (u.ClaveSolicitada.HasValue)
                                    {
                                        <span class="badge bg-info text-dark" title="Solicitó restablecer su contraseña el @u.ClaveSolicitada.Value.ToString("dd/MM/yyyy HH:mm")">Pidió nueva clave</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-controller="Admin" asp-action="EditarUsuario" asp-route-id="@u.ConsecutivoUsuario" class="btn btn-sm btn-outline-secondary @(esPropio ? "disabled" : "")" title="Cambiar rol o sección"><i class="bi bi-pencil"></i></a>

                                    <form asp-controller="Admin" asp-action="RestablecerClave" asp-route-id="@u.ConsecutivoUsuario" method="post" class="d-inline"
                                          onsubmit="return confirm('Se generará una contraseña temporal y la actual dejará de funcionar. ¿Continuar?');">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Restablecer contraseña"><i class="bi bi-key"></i></button>
                                    </form>

                                    @* Dos formularios distintos (Activar / Desactivar): no se envía ningún true/false en el HTML. *@
                                    @if (u.Activo)
                                    {
                                        if (!esPropio)
                                        {
                                            <form asp-controller="Admin" asp-action="Desactivar" asp-route-id="@u.ConsecutivoUsuario" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Desactivar a este usuario? Perderá el acceso de inmediato.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="Activar" asp-route-id="@u.ConsecutivoUsuario" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Activar a este usuario?');">
                                            <button type="submit" class="btn btn-sm btn-success">@(u.Pendiente ? "Aprobar" : "Activar")</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
