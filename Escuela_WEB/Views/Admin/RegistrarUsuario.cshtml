@model RegistrarUsuarioAdminViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
    var secciones = ViewBag.Secciones as List<string> ?? new List<string>();
}

<h3>Registrar nuevo usuario</h3>

<div class="card" style="max-width:550px;">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <form asp-controller="Admin" asp-action="RegistrarUsuario" method="post">
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CorreoElectronico" class="form-label"></label>
                <input asp-for="CorreoElectronico" class="form-control" />
                <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Contrasenna" class="form-label"></label>
                <input asp-for="Contrasenna" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Contrasenna" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select" id="selRol">
                    <option value="Estudiante">Estudiante</option>
                    <option value="Docente">Docente</option>
                    <option value="Director">Director</option>
                </select>
            </div>
            <div class="mb-3" id="bloqueSeccion">
                <label asp-for="Seccion" class="form-label"></label>
                <select asp-for="Seccion" class="form-select" asp-items="@(new SelectList(secciones))">
                    <option value="">-- Seleccione la sección --</option>
                </select>
                <span asp-validation-for="Seccion" class="text-danger"></span>
            </div>
            <div class="form-text mb-3" id="notaSinSeccion" style="display:none;">
                Docentes y directores no tienen sección: las asignaturas de un docente se crean en «Asignaturas».
            </div>
            <button type="submit" class="btn btn-principal">Crear usuario</button>
            <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function actualizarRol() {
            const esEstudiante = document.getElementById('selRol').value === 'Estudiante';
            document.getElementById('bloqueSeccion').style.display = esEstudiante ? '' : 'none';
            document.getElementById('notaSinSeccion').style.display = esEstudiante ? 'none' : '';
        }
        document.getElementById('selRol').addEventListener('change', actualizarRol);
        actualizarRol();
    </script>
}
