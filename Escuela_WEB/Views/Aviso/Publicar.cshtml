@model RegistrarAvisoViewModel
@{
    ViewData["Title"] = "Publicar aviso";
    var esDirector = (bool)(ViewBag.EsDirector ?? false);
    var secciones = ViewBag.Secciones as List<string> ?? new List<string>();
}

<h3>Publicar nuevo aviso</h3>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (!esDirector && !secciones.Any())
        {
            <div class="alert alert-warning mb-0">
                Aún no tiene asignaturas activas, por lo que no hay ninguna sección a la que dirigir avisos.
                La dirección debe asignarle una asignatura primero.
            </div>
        }
        else
        {
            <form asp-controller="Aviso" asp-action="Publicar" method="post">
                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label"></label>
                    <input asp-for="Titulo" class="form-control" maxlength="200" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Contenido" class="form-label"></label>
                    <textarea asp-for="Contenido" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Contenido" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Prioridad" class="form-label"></label>
                    <select asp-for="Prioridad" class="form-select">
                        <option value="General">General</option>
                        <option value="Información">Información</option>
                        <option value="Importante">Importante</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="Seccion" class="form-label"></label>
                    <select asp-for="Seccion" class="form-select" asp-items="@(new SelectList(secciones))">
                        @if (esDirector)
                        {
                            <option value="">Toda la institución</option>
                        }
                        else
                        {
                            <option value="">-- Seleccione la sección --</option>
                        }
                    </select>
                    <span asp-validation-for="Seccion" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-principal">Publicar</button>
                <a asp-controller="Aviso" asp-action="Index" class="btn btn-link">Cancelar</a>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
