@model RecuperarAccesoViewModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Recuperar acceso";
}

<div class="login-card">
    <h2>Recuperar acceso</h2>
    <p class="sub">Indique su correo y la dirección de la escuela le entregará una contraseña temporal.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@ViewBag.Mensaje</div>
    }

    <form asp-controller="Usuario" asp-action="RecuperarAcceso" method="post" novalidate>
        <div class="mb-3">
            <label asp-for="CorreoElectronico" class="form-label"></label>
            <input asp-for="CorreoElectronico" class="form-control" autocomplete="username" />
            <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-principal w-100 py-2">Solicitar contraseña temporal</button>
    </form>

    <div class="text-center mt-3 small">
        <a asp-controller="Home" asp-action="Index">Volver al inicio de sesión</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
