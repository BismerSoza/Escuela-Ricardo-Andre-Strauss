@model string
@{
    var nombreCompleto = (ViewBag.Nombre as string ?? "").Trim();
    var primerNombre = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 18 ? "Buenas tardes" : "Buenas noches";
    var fecha = DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CR"));
    fecha = char.ToUpper(fecha[0]) + fecha.Substring(1);
}
<section class="hero">
    <div>
        <div class="hero-kicker">@fecha</div>
        <h1 class="hero-title">@saludo, @primerNombre</h1>
        <p class="hero-text">@Model</p>
    </div>
    <div class="hero-sello d-none d-md-flex">
        <i class="bi bi-mortarboard"></i>
        <span>Curso lectivo 2026</span>
    </div>
</section>
