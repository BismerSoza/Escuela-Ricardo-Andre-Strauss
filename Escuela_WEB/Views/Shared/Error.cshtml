@{
    Layout = "_LayoutExterno";
    ViewData["Title"] = "Error";
    var mensaje = ViewData["Mensaje"] as string ?? "Ocurrió un error inesperado. Por favor intente nuevamente.";
}

<div class="card tarjeta-login">
    <div class="card-body p-4 text-center">
        <i class="bi bi-exclamation-octagon text-danger" style="font-size:3rem;"></i>
        <h4 class="mt-3">Algo salió mal</h4>
        <p class="text-muted">@mensaje</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-principal">Volver al inicio</a>
    </div>
</div>
