@model PanelHistorialViewModel
@{
    ViewData["Title"] = "Historial académico";
    var puedeRegistrar = (bool)(ViewBag.PuedeRegistrar ?? false);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-graph-up me-2"></i>Historial académico</h3>
    <div class="d-flex gap-2">
        @if (puedeRegistrar)
        {
            <a asp-controller="Historial" asp-action="ImportarCsv" class="btn btn-outline-secondary"><i class="bi bi-upload me-1"></i>Importar CSV</a>
        }
        @if (Model.EstudianteSeleccionado != null)
        {
            <a asp-controller="Historial" asp-action="ExportarPdf" asp-route-estudianteId="@Model.EstudianteSeleccionado" class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-pdf me-1"></i>Exportar PDF
            </a>
        }
    </div>
</div>

<div class="card my-3">
    <div class="card-body">
        <h5 class="card-title">Seleccionar estudiante</h5>
        <form method="get" asp-controller="Historial" asp-action="Index" id="formSeleccion">
            <select name="estudianteId" class="form-select" onchange="document.getElementById('formSeleccion').submit();">
                @foreach (var e in Model.Estudiantes)
                {
                    if (Model.EstudianteSeleccionado == e.ConsecutivoUsuario)
                    {
                        <option value="@e.ConsecutivoUsuario" selected>@e.Nombre (@(e.Seccion ?? "sin sección"))</option>
                    }
                    else
                    {
                        <option value="@e.ConsecutivoUsuario">@e.Nombre (@(e.Seccion ?? "sin sección"))</option>
                    }
                }
            </select>
        </form>
    </div>
</div>

@if (puedeRegistrar)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Registrar nueva entrada</h5>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form asp-controller="Historial" asp-action="Registrar" method="post" class="row g-2">
                <input type="hidden" asp-for="NuevoRegistro.ConsecutivoEstudiante" value="@Model.EstudianteSeleccionado" />
                <div class="col-md-4">
                    <select name="Materia" class="form-select" required>
                        <option value="">-- Materia --</option>
                        @foreach (var m in Model.MateriasDisponibles)
                        {
                            <option value="@m.Nombre">@m.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <input asp-for="NuevoRegistro.Periodo" class="form-control" placeholder="Periodo (ej: I Trimestre 2026)" />
                </div>
                <div class="col-md-2">
                    <input asp-for="NuevoRegistro.Nota" class="form-control" type="number" step="0.1" min="0" max="100" placeholder="Nota" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-principal">Agregar</button>
                </div>
                <div class="col-12">
                    <input asp-for="NuevoRegistro.Observacion" class="form-control" placeholder="Observación (opcional)" />
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">Como Director, puede consultar y exportar el historial; el registro de notas lo realiza el docente de cada asignatura.</div>
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Registros</h5>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Materia</th>
                        <th>Periodo</th>
                        <th>Nota</th>
                        <th>Observación</th>
                        <th>Registrado por</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Registros.Any())
                    {
                        <tr><td colspan="6" class="text-muted">No hay registros aún para este estudiante.</td></tr>
                    }
                    else
                    {
                        foreach (var r in Model.Registros)
                        {
                            <tr>
                                <td>@r.Materia</td>
                                <td>@r.Periodo</td>
                                <td>@(r.Nota?.ToString("0.##") ?? "-")</td>
                                <td>@(r.Observacion ?? "-")</td>
                                <td>@r.Docente</td>
                                <td>@r.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
