@{
    ViewData["Title"] = "Importar calificaciones";
}

<h3><i class="bi bi-upload me-2"></i>Importar calificaciones desde CSV</h3>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <p class="text-muted">
            El archivo debe ser un CSV con las siguientes columnas (con encabezado):
        </p>
        <pre class="bg-light p-2 rounded small">CorreoEstudiante,Materia,Periodo,Nota,Observacion
estudiante1@escuela.cr,Matemática,II Trimestre 2026,90,Buen trabajo
estudiante2@escuela.cr,Matemática,II Trimestre 2026,75,</pre>

        <form asp-controller="Historial" asp-action="ImportarCsv" method="post" enctype="multipart/form-data" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Archivo CSV</label>
                <input type="file" name="archivo" class="form-control" accept=".csv" required />
            </div>
            <button type="submit" class="btn btn-principal"><i class="bi bi-upload me-1"></i>Importar</button>
            <a asp-controller="Historial" asp-action="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>
