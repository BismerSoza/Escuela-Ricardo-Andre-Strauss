@model RegistrarMateriaViewModel
@{
    ViewData["Title"] = "Nueva asignatura";
    var rol = Context.Session.GetString("Rol");
    var secciones = ViewBag.Secciones as List<string> ?? new List<string>();
    var docentes = ViewBag.Docentes as List<UsuarioAdminViewModel> ?? new List<UsuarioAdminViewModel>();
}

<h3>Registrar nueva asignatura</h3>

<div class="card" style="max-width:550px;">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <form asp-controller="Materia" asp-action="Registrar" method="post">
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Matemática" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Seccion" class="form-label"></label>
                <select asp-for="Seccion" class="form-select" asp-items="@(new SelectList(secciones))">
                    <option value="">-- Seleccione la sección --</option>
                </select>
                <span asp-validation-for="Seccion" class="text-danger"></span>
            </div>

            @if (rol == "Director")
            {
                <div class="mb-3">
                    <label asp-for="ConsecutivoDocente" class="form-label"></label>
                    <select asp-for="ConsecutivoDocente" class="form-select">
                        <option value="">-- Seleccione un docente --</option>
                        @foreach (var d in docentes)
                        {
                            <option value="@d.ConsecutivoUsuario" selected="@(Model.ConsecutivoDocente == d.ConsecutivoUsuario)">@d.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="ConsecutivoDocente" class="text-danger"></span>
                    <div class="form-text">Al asignarle una asignatura, el docente verá automáticamente a los estudiantes de esa sección.</div>
                </div>
            }

            <button type="submit" class="btn btn-principal">Registrar</button>
            <a asp-controller="Materia" asp-action="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
